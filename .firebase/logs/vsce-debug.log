[info] [Firebase Plugin] ExecuteGraphQL (https://firebasedataconnect.googleapis.com) request: {
    "operationName": "CreateExpense",
    "variables": {},
    "query": "# 1. Create or update the currently logged-in user's profile\r\nmutation UpsertCurrentUser($username: String!, $phone: String!) @auth(level: USER) {\r\n  user_upsert(\r\n    data: {\r\n      id_expr: \"auth.uid\"\r\n      username: $username\r\n      phone: $phone\r\n      totalMissing: 0.0\r\n      totalDebt: 0.0\r\n    }\r\n  )\r\n}\r\n\r\n# 2. Update a user's running debt/missing totals\r\nmutation UpdateUserBalances(\r\n  $userId: String!\r\n  $totalMissing: Float!\r\n  $totalDebt: Float!\r\n) @auth(level: USER, insecureReason: \"Authenticated users can update participant balances when creating or settling expenses\") {\r\n  user_update(\r\n    key: { id: $userId }\r\n    data: {\r\n      totalMissing: $totalMissing\r\n      totalDebt: $totalDebt\r\n    }\r\n  )\r\n}\r\n\r\n# 3. Create a new expense owned by the currently logged-in user\r\nmutation CreateExpense($name: String!, $amount: Float!) @auth(level: USER) {\r\n  expense_insert(\r\n    data: {\r\n      userId_expr: \"auth.uid\"\r\n      name: $name\r\n      amount: $amount\r\n    }\r\n  )\r\n}\r\n\r\n# 4. Add a debtor to an expense (only allowed if the caller owns the expense)\r\nmutation AddDebtorToExpense(\r\n  $expenseId: UUID!\r\n  $debtorUserId: String!\r\n  $shareAmount: Float!\r\n) @auth(level: USER) {\r\n  query @redact {\r\n    expense(key: { id: $expenseId })\r\n      @check(expr: \"this != null && this.user.id == auth.uid\", message: \"Only the expense creator can add debtors\") {\r\n      user {\r\n        id\r\n      }\r\n    }\r\n  }\r\n  expenseProvider_insert(\r\n    data: {\r\n      expenseId: $expenseId\r\n      userId: $debtorUserId\r\n      shareAmount: $shareAmount\r\n    }\r\n  )\r\n}\r\n\r\n# 5. Settle/remove a debtor's share (only allowed if the caller owns the expense)\r\nmutation SettleUserShare($expenseId: UUID!, $debtorUserId: String!) @auth(level: USER) {\r\n  query @redact {\r\n    expense(key: { id: $expenseId })\r\n      @check(expr: \"this != null && this.user.id == auth.uid\", message: \"Only the expense creator can settle shares\") {\r\n      user {\r\n        id\r\n      }\r\n    }\r\n  }\r\n  expenseProvider_delete(\r\n    key: {\r\n      expenseId: $expenseId\r\n      userId: $debtorUserId\r\n    }\r\n  )\r\n}\r\n\r\n# 6. Delete an expense (only allowed if the caller owns the expense)\r\nmutation DeleteExpense($expenseId: UUID!) @auth(level: USER) {\r\n  query @redact {\r\n    expense(key: { id: $expenseId })\r\n      @check(expr: \"this != null && this.user.id == auth.uid\", message: \"Only the expense creator can delete this expense\") {\r\n      user {\r\n        id\r\n      }\r\n    }\r\n  }\r\n  expense_delete(key: { id: $expenseId })\r\n}\n# 1. Get the logged-in user's profile, expenses they paid for, and debts they owe\r\nquery GetMyProfileAndExpenses @auth(level: USER) {\r\n  user(key: { id_expr: \"auth.uid\" }) {\r\n    id\r\n    username\r\n    phone\r\n    totalMissing\r\n    totalDebt\r\n\r\n    # Expenses THIS user created (money owed TO them)\r\n    expenses_on_user {\r\n      id\r\n      name\r\n      amount\r\n      expenseProviders_on_expense {\r\n        shareAmount\r\n        user {\r\n          id\r\n          username\r\n        }\r\n      }\r\n    }\r\n\r\n    # Expenses OTHER users created where THIS user owes a share\r\n    expenseProviders_on_user {\r\n      shareAmount\r\n      expense {\r\n        id\r\n        name\r\n        amount\r\n        user {\r\n          id\r\n          username\r\n        }\r\n      }\r\n    }\r\n  }\r\n}\r\n\r\n# 2. List all users so the user can pick friends to split an expense with\r\nquery ListUsers @auth(level: USER, insecureReason: \"Authenticated users can browse users to split expenses with\") {\r\n  users {\r\n    id\r\n    username\r\n    phone\r\n  }\r\n}\r\n\r\n# 3. Search for a user by username or phone number\r\nquery FindUser($search: String!) @auth(level: USER, insecureReason: \"Authenticated users can search for users by username or phone\") {\